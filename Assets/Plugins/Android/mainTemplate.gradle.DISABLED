apply plugin: 'com.android.library'
**APPLY_PLUGINS**

dependencies {
    
// Android Resolver Dependencies Start
implementation fileTree(dir: 'libs', include: ['*.jar'])
implementation 'com.google.android.gms:play-services-ads-identifier:18.1.0' // Assets/LevelPlay/Editor/IronSourceSDKDependencies.xml:12
implementation 'com.unity3d.ads:unity-ads:4.16.5' // Assets/LevelPlay/Editor/ISUnityAdsAdapterDependencies.xml:9
implementation 'com.unity3d.ads-mediation:mediation-sdk:9.2.0' // Assets/LevelPlay/Editor/IronSourceSDKDependencies.xml:5
implementation 'com.unity3d.ads-mediation:unityads-adapter:5.4.0' // Assets/LevelPlay/Editor/ISUnityAdsAdapterDependencies.xml:5
// Android Resolver Dependencies End
**DEPS**}

// Android Resolver Exclusions Start
android {
  packagingOptions {
      exclude ('/lib/armeabi/*' + '*')
      exclude ('/lib/mips/*' + '*')
      exclude ('/lib/mips64/*' + '*')
      exclude ('/lib/x86/*' + '*')
      exclude ('/lib/x86_64/*' + '*')
  }
}
// Android Resolver Exclusions End
android {
    namespace "com.unity3d.player"
    ndkPath "**NDKPATH**"
    compileSdkVersion **APIVERSION**
    buildToolsVersion '**BUILDTOOLS**'

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_11
        targetCompatibility JavaVersion.VERSION_11
    }

    defaultConfig {
        minSdkVersion **MINSDKVERSION**
        targetSdkVersion targetSdkVersion 34
        ndk {
            abiFilters **ABIFILTERS**
        }
        versionCode **VERSIONCODE**
        versionName '**VERSIONNAME**'
        consumerProguardFiles 'proguard-unity.txt'**USER_PROGUARD**
        multiDexEnabled true
    }

    lintOptions {
        abortOnError false
    }

    aaptOptions {
        noCompress = **BUILTIN_NOCOMPRESS** + unityStreamingAssets.tokenize(', ')
        ignoreAssetsPattern = "!.svn:!.git:!.ds_store:!*.scc:!CVS:!thumbs.db:!picasa.ini:!*~"
    }**PACKAGING_OPTIONS**
}

tasks.withType(com.android.build.gradle.internal.tasks.DexArchiveBuilderTask) {
    it.setCanRunConcurrently(false)
}
configurations.all {
    resolutionStrategy {
        force 'androidx.core:core:1.9.0'
        force 'androidx.activity:activity:1.2.3'
        force 'androidx.annotation:annotation:1.3.0'
        force 'androidx.lifecycle:lifecycle-common:2.4.0'
        force 'androidx.lifecycle:lifecycle-runtime:2.4.0'
        force 'androidx.arch.core:core-runtime:2.1.0'
        force 'androidx.arch.core:core-common:2.1.0'
    }
}
**IL_CPP_BUILD_SETUP**
**SOURCE_BUILD_SETUP**
**EXTERNAL_SOURCES**

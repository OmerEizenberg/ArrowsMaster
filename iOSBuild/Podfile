source 'https://cdn.cocoapods.org/'
source 'https://github.com/CocoaPods/Specs'

platform :ios, '15.0'

target 'UnityFramework' do
  pod 'Firebase/Analytics', '12.8.0'
  pod 'Firebase/Core', '12.8.0'
  pod 'Firebase/Crashlytics', '12.8.0'
  pod 'Firebase/Messaging', '12.8.0'
  pod 'IronSourceSDK', '9.3.0.0'
  pod 'IronSourceUnityAdsAdapter', '5.5.0.0'
end
target 'Unity-iPhone' do
end
use_frameworks! :linkage => :static


# FIX_FB12_S6
post_install do |installer|
  # --- Existing Unity/Firebase/Other Logic ---
  # If you had lines like 'flipper_post_install(installer)' or others, keep them here.

  # --- Our New Fixes ---
  installer.pods_project.targets.each do |target|
    
    # Fix 1: The original CFBundleExecutable error
    if target.name.include? 'FBLPromises_Privacy'
      target.build_configurations.each do |config|
        config.build_settings['EXECUTABLE_NAME'] = ''
      end
    end

    # Fix 2: M1/M2/M3 Architecture and Deployment Target
    target.build_configurations.each do |config|
      # Forces all pods to a consistent iOS version to prevent "mismatch" errors
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Prevents arm64 simulator conflicts on Apple Silicon
      config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
    end
  end
end
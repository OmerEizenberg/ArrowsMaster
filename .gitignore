# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive
/[Mm]emoryCaptures/

# Asset hash cache used for speed in importing assets
/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.IDB
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file extensionToReplace
*.unitypackage
*.apk
*.aab
*.unitypackage.meta

# Windows design file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# iOS Builds
/[Ii]OSBuilds/

# Large Firebase files (>100MB)
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-13_7_0.bundle
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-13_7_0.so
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-13_7_0.bundle.meta
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-13_7_0.so.meta

# Local test files
level_diff2_fixed.json
level_diff4.json
level_output.json
test_easy.json
test_level_hard.json
test_level_perpendicular.json
